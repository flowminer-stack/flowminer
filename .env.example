# FlowMiner configuration — copy to `.env` before starting.
#
# The `docker-compose.yml` file refuses to start if the REQUIRED
# values below are missing. Generate real secrets locally — never
# commit a real `.env` to source control.

# ─── Environment ──────────────────────────────────────────────────────
# "development" | "production"
# In production mode the backend hard-fails at startup on any
# insecure default, so don't set this to "production" until you've
# set every REQUIRED value below.
ENV=development

# ─── Demo mode (optional) ─────────────────────────────────────────────
# Set to 1 to turn this stack into a locked-down public demo: the
# backend seeds a demo user + sample event logs on startup, the
# /auth/demo endpoint hands out anonymous JWTs, and a write-guard
# middleware rejects every POST/PUT/PATCH/DELETE outside the
# analytics allowlist. Leave unset for a normal self-host instance.
# See deploy/demo/README.md for the full demo deployment story.
DEMO_MODE=0

# ─── Sample-data seed (optional) ──────────────────────────────────────
# Set to 1 to populate the instance with three sample projects on
# first boot — the pm4py running-example, sepsis cases, and a
# container-logistics OCEL log. Unlike DEMO_MODE this leaves writes,
# uploads, and admin features fully enabled, so it's the right flag
# for trial deployments where customers want example data to click
# through. The seeder is idempotent (a restart never duplicates
# data) and creates a "Demo Visitor" viewer user that an admin can
# delete after the trial.
SEED_SAMPLE_DATA_ON_FIRST_BOOT=0

# ─── REQUIRED secrets ─────────────────────────────────────────────────
# Generate with:  openssl rand -hex 32
SECRET_KEY=

# Fernet key used to encrypt connector credentials, stored LLM API
# keys, and other sensitive fields at rest. Optional but strongly
# recommended — if unset, secret_box derives a key from SECRET_KEY
# which means rotating SECRET_KEY also invalidates all encrypted
# secrets. A dedicated key lets you rotate them independently.
#
# !! BACK THIS KEY UP SEPARATELY from your database backups !! It is NOT
# included in pg_dump / `make backup`. If you restore a database onto an
# instance with a different (or missing) key, the app still boots but every
# stored credential is unreadable, with no error. See docs/BACKUP.md.
#
# Generate with:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
FLOWMINER_ENCRYPTION_KEY=

# ─── PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_USER=flowminer
# Generate with:  openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=flowminer

# ─── Redis ────────────────────────────────────────────────────────────
# Required — no default fallback. Celery uses Redis as its broker and
# an unauthenticated broker is a free denial-of-service vector.
# Generate with:  openssl rand -hex 24
REDIS_PASSWORD=

# ─── Upload directory + size limits ───────────────────────────────────
UPLOAD_DIR=/data/uploads
# 500 MB
MAX_UPLOAD_SIZE=524288000

# ─── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of origins that may call the API from a
# browser. Use the public URL of your SPA here, not localhost.
CORS_ORIGINS=http://localhost:3000,http://localhost

# ─── App metadata ─────────────────────────────────────────────────────
APP_NAME=FlowMiner
# The app version reported on /health is baked into the Docker image at
# build time from the release tag — there is intentionally no
# APP_VERSION line here (it would shadow the baked-in value).
#
# FLOWMINER_VERSION below selects WHICH released image tag docker compose
# pulls and runs. It is used only for image selection (compose
# interpolation) and is NOT injected into the container, so it never
# shadows the version the running app reports. Pin it to a release tag
# for reproducible upgrades; leave it commented to use the compose
# default (v0.1.0).
# FLOWMINER_VERSION=v0.1.0

# ─── Optional public-host configuration ──────────────────────────────
# The port where the SPA nginx container listens on the host.
FLOWMINER_FRONTEND_PORT=3000

# The port for the reverse-proxy nginx service (only enabled when
# you run `docker compose --profile production up`).
FLOWMINER_PUBLIC_PORT=80

# ─── Observability (optional) ────────────────────────────────────────
# Sentry DSN. Leave empty to disable.
SENTRY_DSN=

# ─── SMTP (optional) ─────────────────────────────────────────────────
# Outbound email for password reset, scheduled reports, and alerts.
# Leave SMTP_HOST empty to disable email entirely.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@flowminer.io

# ─── LLM provider (optional) ─────────────────────────────────────────
# You can configure the LLM provider either HERE (env-var style) or
# via the Settings page in the UI once logged in as admin. Values
# set in the Settings page override env vars.
#
# Providers: anthropic | openai | openrouter | ollama | null
# "null" returns templated responses, so the UI works end-to-end
# with no credentials configured. Great for demos and CI.
FLOWMINER_LLM_PROVIDER=null

# OpenRouter — one API key unlocks dozens of models
# (Claude, GPT, Gemini, Llama, DeepSeek, Mistral, ...).
OPENROUTER_API_KEY=
# Base model — the chat/agent workhorse and the default for every feature
# that has no per-workload override below. Reliable picks (mid-2026):
#   openai/gpt-4.1-mini      best value: rock-solid tools+JSON, 1M ctx, fast
#   anthropic/claude-haiku-4.5  premium default: best writing + agent judgment
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Optional ranking headers shown on OpenRouter's dashboards.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=FlowMiner

# ── Per-workload model overrides (optional) ──────────────────────────
# FlowMiner routes each AI feature to one of these by workload class. Leave
# blank to use OPENROUTER_MODEL (or the provider's model) for everything; set
# one to split the cheap/strong tiers per feature. Use ids valid for your
# provider (OpenRouter slugs shown). Each also has a Settings-page key
# (llm.model.chat / .code / .writing / .mapping) that overrides the env var.
#   A/B  chat + agent loop + structured JSON (explain, best-practice)
FLOWMINER_LLM_MODEL_CHAT=
#   C    code-gen: extract-copilot SQL + text-to-BPMN — worth a stronger model,
#        e.g. anthropic/claude-sonnet-4.6 or openai/gpt-4.1
FLOWMINER_LLM_MODEL_CODE=
#   D    grounded writing: narrate report + explain-variant,
#        e.g. anthropic/claude-haiku-4.5
FLOWMINER_LLM_MODEL_WRITING=
#   E    column-mapping classification — tiny/cheap nano,
#        e.g. openai/gpt-5-nano or qwen/qwen3.5-flash (back-compat: MAPPING_LLM_MODEL)
MAPPING_LLM_MODEL=

# Anthropic direct
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI direct (and Azure OpenAI — set OPENAI_BASE_URL if needed)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama — run models locally, no API key needed. Point this at your
# Ollama host; the backend container needs to be able to reach it.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
